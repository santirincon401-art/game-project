[sub_resource type="GDScript" id="GDScript_pqewn"]
script/source = "extends CharacterBody2D

# --- CONFIGURACIÓN Y ESTADÍSTICAS ---
@export var vida_maxima: int = 50
var vida_actual: int
var jugador: Node2D

@export var velocidad_base: float = 140.0
var velocidad_actual: float = 140.0

# Estados y Fases
enum Fase { FASE_1, FASE_2, FURIA }
var fase_actual = Fase.FASE_1

# Referencias internas
@onready var timer_ataque: Timer = $TimerAtaque

# Sistema de patrones de ataque
var patron_actual: int = 0
var rng = RandomNumberGenerator.new()

func _ready() -> void:
	rng.randomize()
	vida_actual = vida_maxima
	velocidad_actual = velocidad_base
	
	await get_tree().process_frame
	jugador = get_tree().get_first_node_in_group(\"jugador\")
	
	# Lo metemos al grupo de enemigos para que las balas o colisiones lo detecten
	add_to_group(\"enemigos\")
	
	# Configurar el temporizador de ataques del jefe
	if timer_ataque:
		timer_ataque.wait_time = 1.5
		timer_ataque.timeout.connect(_on_patron_timeout)
		timer_ataque.start()
	
	print(\"¡El Jefe Final ha entrado en combate!\")


func _physics_process(delta: float) -> void:
	if not jugador:
		return
	
	# --- MOVIMIENTO DINÁMICO SEGÚN LA FASE ---
	var direccion = global_position.direction_to(jugador.global_position)
	
	match fase_actual:
		Fase.FASE_1:
			# Movimiento clásico persiguiendo al jugador suavemente
			velocity = direccion * velocidad_actual
		Fase.FASE_2:
			# Movimiento más agresivo, orbitando o flotando erráticamente
			var vector_lateral = Vector2(-direccion.y, direccion.x) * sin(Time.get_ticks_msec() * 0.005) * 150.0
			velocity = (direccion * velocidad_actual) + vector_lateral
		Fase.FURIA:
			# Velocidad extrema en línea recta hacia el jugador
			velocity = direccion * (velocidad_actual * 1.6)
			
	move_and_slide()
	
	# --- GESTIÓN DE CAMBIO DE FASES POR VIDA ---
	verificar_cambios_de_fase()


func verificar_cambios_de_fase() -> void:
	var porcentaje_vida = float(vida_actual) / float(vida_maxima)
	
	if porcentaje_vida <= 0.65 and porcentaje_vida > 0.3 and fase_actual == Fase.FASE_1:
		fase_actual = Fase.FASE_2
		velocidad_actual = 180.0
		if timer_ataque:
			timer_ataque.wait_time = 1.0 # Ataca más rápido
		print(\"¡JEFE: FASE 2 ACTIVADA! Patrones mejorados.\")
		efecto_cambio_fase()
		
	elif porcentaje_vida <= 0.3 and fase_actual != Fase.FURIA:
		fase_actual = Fase.FURIA
		velocidad_actual = 230.0
		if timer_ataque:
			timer_ataque.wait_time = 0.6 # Modo masacre total
		print(\"¡JEFE: MODO FURIA DESATADO!\")
		efecto_cambio_fase()


func efecto_cambio_fase() -> void:
	# Un efecto visual rápido con tween al cambiar de fase
	var tween = create_tween()
	tween.tween_property(self, \"modulate\", Color(1, 0.2, 0.2), 0.2)
	tween.tween_property(self, \"modulate\", Color(1, 1, 1), 0.2)


# --- SISTEMA DE ATAQUES Y PATRONES ---

func _on_patron_timeout() -> void:
	if not jugador:
		return
	
	# Dependiendo de la fase, elegimos qué ataque ejecutar
	match fase_actual:
		Fase.FASE_1:
			patron_fase_1()
		Fase.FASE_2:
			patron_fase_2()
		Fase.FURIA:
			patron_furia()


func patron_fase_1() -> void:
	var opcion = rng.randi_range(1, 2)
	if opcion == 1:
		disparar_abanico_balas()
	else:
		lanzar_misil_teledirigido()


func patron_fase_2() -> void:
	var opcion = rng.randi_range(1, 3)
	if opcion == 1:
		disparar_abanico_balas()
		disparar_circulo_completo()
	elif opcion == 2:
		teleportarse_cerca_jugador()
	else:
		onda_expansiva_de_proyectiles()


func patron_furia() -> void:
	var opcion = rng.randi_range(1, 3)
	if opcion == 1:
		disparar_circulo_completo()
		lanzar_misil_teledirigido()
	elif opcion == 2:
		teleportarse_cerca_jugador()
		disparar_abanico_balas()
	else:
		# ¡Ataque combinado caótico!
		onda_expansiva_de_proyectiles()
		disparar_circulo_completo()


# --- IMPLEMENTACIÓN DE LOS ATAQUES ---

func disparar_abanico_balas() -> void:
	print(\"Jefe: ¡Disparando abanico de proyectiles!\")
	# Aquí instanciarías tus balas en abanico frente al jefe
	if Sonidos: Sonidos.play(\"disparo\")


func disparar_circulo_completo() -> void:
	print(\"Jefe: ¡Lluvia de balas en 360 grados!\")
	# Simulación de un anillo masivo de balas alrededor del jefe
	for i in range(12):
		var angulo = (TAU / 12.0) * i
		var direccion_bala = Vector2.RIGHT.rotated(angulo)
		# Instanciar bala con direccion_bala ...
	if Sonidos: Sonidos.play(\"disparo\")


func lanzar_misil_teledirigido() -> void:
	print(\"Jefe: ¡Misil teledirigido lanzado hacia el jugador!\")
	# Lógica para soltar un proyectil que persiga la posición del jugador


func teleportarse_cerca_jugador() -> void:
	if not jugador:
		return
	print(\"Jefe: ¡Teletransporte sorpresa!\")
	
	# Efecto visual de desaparición
	var tween_out = create_tween()
	tween_out.tween_property(self, \"modulate:a\", 0.0, 0.15)
	await tween_out.finished
	
	# Aparecer cerca del jugador con un pequeño offset aleatorio
	var offset_aleatorio = Vector2(rng.randf_range(-150, 150), rng.randf_range(-150, 150))
	global_position = jugador.global_position + offset_aleatorio
	
	# Efecto visual de aparición
	var tween_in = create_tween()
	tween_in.tween_property(self, \"modulate:a\", 1.0, 0.15)
	
	# Onda expansiva instantánea al reaparecer en Furia
	if fase_actual == Fase.FURIA:
		disparar_abanico_balas()


func onda_expansiva_de_proyectiles() -> void:
	print(\"Jefe: ¡Onda expansiva masiva!\")
	# Disparo masivo en ráfaga rápida en cruz o espiral


# --- SISTEMA DE DAÑO Y DESTRUCCIÓN ---

func recibir_dano(cantidad: int) -> void:
	vida_actual -= cantidad
	
	# Efecto visual de golpe (flash rojo)
	var tween_dano = create_tween()
	tween_dano.tween_property(self, \"modulate\", Color(10, 2, 2), 0.05)
	tween_dano.tween_property(self, \"modulate\", Color(1, 1, 1), 0.05)
	
	if Sonidos:
		Sonidos.play(\"dano\")
		
	print(\"Vida del Jefe: \", vida_actual, \" / \", vida_maxima)
	
	if vida_actual <= 0:
		morir()


func morir() -> void:
	print(\"¡EL JEFE FINAL HA SIDO DERROTADO ÉPICAMENTE!\")
	if timer_ataque:
		timer_ataque.stop()
		
	if Sonidos:
		Sonidos.play(\"explosion\")
		
	# Secuencia de muerte con explosiones y desvanecimiento
	var tween_muerte = create_tween()
	tween_muerte.parallel().tween_property(self, \"scale\", Vector2(1.8, 1.8), 0.8)
	tween_muerte.parallel().tween_property(self, \"modulate\", Color(0, 0, 0, 0), 0.8)
	
	await tween_muerte.finished
	
	# Aquí puedes abrir la pantalla de victoria del juego o pasar créditos
	get_tree().paused = true
	queue_free()
"

